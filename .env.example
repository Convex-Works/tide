TIDE_ADDR=:8080
TIDE_BASE_URL=http://localhost:8080
TIDE_SESSION_SECRET=tide-dev-session-secret-please-change
TIDE_DB_PATH=./data/tide.db

TIDE_LIVEKIT_URL=ws://localhost:7880
TIDE_LIVEKIT_PUBLIC_URL=ws://localhost:7880
TIDE_LIVEKIT_API_KEY=devkey
TIDE_LIVEKIT_API_SECRET=tide-dev-secret-please-change-0000000000

TIDE_OIDC_ISSUER=http://localhost:5556/dex
TIDE_OIDC_CLIENT_ID=tide
TIDE_OIDC_CLIENT_SECRET=tide-dev-oidc-secret

TIDE_S3_ENDPOINT=http://localhost:9000
TIDE_S3_PUBLIC_ENDPOINT=http://localhost:9000
TIDE_S3_BUCKET=tide-recordings
TIDE_S3_ACCESS_KEY=tide
TIDE_S3_SECRET_KEY=tide-dev-minio
TIDE_S3_REGION=us-east-1

# Egress runs in Docker; its Chrome must use the host-reachable Vite route in dev.
TIDE_EGRESS_TEMPLATE_URL=http://host.docker.internal:5173/egress-template

# Dev mode is opt-in. It enables the unauthenticated /api/dev/token route and
# allows the publicly-known dev secrets above. Without it the server refuses
# to start unless every secret is set, strong, and not a shipped default.
TIDE_DEV_MODE=true

# Transcripts and machine pairing through moil (docs/ARCHITECTURE.md §8.1).
# Off by default; development turns them on to work on them.
TIDE_TRANSCRIPTS=true

# Reverse proxies allowed to set X-Forwarded-For (comma-separated CIDRs).
# Required behind an ingress or the rate limiter sees one client.
# TIDE_TRUSTED_PROXIES=10.0.0.0/8
