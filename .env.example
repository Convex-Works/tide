KLISI_ADDR=:8080
KLISI_BASE_URL=http://localhost:8080
KLISI_SESSION_SECRET=klisi-dev-session-secret-please-change
KLISI_DB_PATH=./data/klisi.db

KLISI_LIVEKIT_URL=ws://localhost:7880
KLISI_LIVEKIT_PUBLIC_URL=ws://localhost:7880
KLISI_LIVEKIT_API_KEY=devkey
KLISI_LIVEKIT_API_SECRET=klisi-dev-secret-please-change-0000000000

KLISI_OIDC_ISSUER=http://localhost:5556/dex
KLISI_OIDC_CLIENT_ID=klisi
KLISI_OIDC_CLIENT_SECRET=klisi-dev-oidc-secret

KLISI_S3_ENDPOINT=http://localhost:9000
KLISI_S3_PUBLIC_ENDPOINT=http://localhost:9000
KLISI_S3_BUCKET=klisi-recordings
KLISI_S3_ACCESS_KEY=klisi
KLISI_S3_SECRET_KEY=klisi-dev-minio
KLISI_S3_REGION=us-east-1

# Egress runs in Docker; its Chrome must use the host-reachable Vite route in dev.
KLISI_EGRESS_TEMPLATE_URL=http://host.docker.internal:5173/egress-template

KLISI_DEV_MODE=true
