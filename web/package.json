{
  "name": "tide-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.e2e.json",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "media:e2e": "playwright test media-lifecycle.spec.ts media-recording.spec.ts media-reliability.spec.ts --config=playwright.media.config.ts --project=chromium --project=webkit",
    "media:fuzz": "playwright test media-fuzz.spec.ts --config=playwright.media.config.ts",
    "media:chaos": "playwright test media-lifecycle.spec.ts media-reliability.spec.ts --config=playwright.media.config.ts --project=chromium"
  },
  "dependencies": {
    "bits-ui": "^2.20.6",
    "cuelume": "file:vendor/cuelume-0.1.2-14a71236.tgz",
    "livekit-client": "2.23.0",
    "phosphor-svelte": "^3.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource/geist-mono": "^5.2.6",
    "@livekit/protocol": "1.53.4",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.3.6"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
